# ═══════════════════════════════════════════════════════════════════════════════
# PERSON JSONs
# ═══════════════════════════════════════════════════════════════════════════════

def write_person_json(person: dict, career: list[dict], relationships_list: list[dict],
                      education_list: list[dict], governance: list[dict],
                      sources: list[dict], gaps: list[dict], confidence: dict,
                      professional: dict = None, style: dict = None) -> str:
    """Write a single person JSON file and return its filename."""
    person_id = person["id"]
    slug_name = person["name"]
    job_short = person["current_post"].replace("/", "_")

    filename = f"{TODAY}-湖南省-{SLUG}-{job_short}-{slug_name}.json"

    doc = {
        "schema_version": "1.0",
        "generated_at": TODAY,
        "investigation_scope": {
            "province": "湖南省",
            "city": SLUG,
            "region": SLUG,
            "job": job_short,
            "task_id": "hunan_湘西土家族苗族自治州",
            "time_focus": "2026年7月",
        },
        "identity": {
            "person_id": person_id,
            "name": person["name"],
            "aliases": [],
            "gender": person.get("gender", ""),
            "ethnicity": person.get("ethnicity", ""),
            "birth": person.get("birth", ""),
            "birthplace": person.get("birthplace", ""),
            "native_place": "",
            "education": education_list,
            "party_join": person.get("party_join", ""),
            "work_start": person.get("work_start", ""),
            "dedupe_keys": {
                "name_birth": f"{person['name']}_{person.get('birth', '')}",
                "name_birthplace": f"{person['name']}_{person.get('birthplace', '')}",
                "official_profile_url": person.get("source", ""),
            },
        },
        "current_status": {
            "current_post": person["current_post"],
            "current_org": person["current_org"],
            "administrative_rank": "",
            "as_of": AS_OF,
            "is_current_confirmed": True,
            "source_ids": ["S001"],
        },
        "career_timeline": career,
        "organizations": [],
        "relationships": relationships_list,
        "governance_record": governance,
        "professional_profile": professional or {},
        "work_style_and_personality": style or {},
        "network_metrics": {},
        "risk_and_integrity_signals": [],
        "source_register": sources,
        "confidence_summary": confidence,
        "open_questions": gaps,
    }

    output_path = STAGING / filename
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, indent=2)
    print(f"   Person JSON: {output_path}")
    return filename


