e=confirmed" /></attvalues></node><node id="3" label="高连立"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="大厂回族自治县人大常委会主任（原县委副书记）" /><attvalue for="2" value="大厂回族自治县人民代表大会常务委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="京东新城报道：2025年多次以县委副书记身份出席活动；2026年2月经新闻报道为县人大常委会主任。confidence=plausible" /></attvalues></node><node id="4" label="高伟英"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="大厂回族自治县委副书记" /><attvalue for="2" value="中共廊坊市大厂回族自治县委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="2026年2月3日大厂县重点工作调度会议报道中提及县委副书记高伟英出席。confidence=plausible" /></attvalues></node><node id="5" label="康建军"><viz:size value="30.0" /><viz:shape value="diamond" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="大厂回族自治县政协主席" /><attvalue for="2" value="中国人民政治协商会议大厂回族自治县委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="2025年大厂县委全会和十五规划研讨会报道中多次以县政协主席身份出席。confidence=plausible" /></attvalues></node><node id="6" label="杨振新"><viz:size value="30.0" /><viz:shape value="diamond" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="原大厂回族自治县人大常委会主任" /><attvalue for="2" value="大厂回族自治县人民代表大会常务委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="2025年8月党建工作会议和12月十五规划研讨会中报道为县人大常委会主任。至2026年2月可能已由高连立接任。confidence=plausible" /></attvalues></node><node id="7" label="杨华勇"><viz:size value="30.0" /><viz:shape value="circle" /><viz:color r="180" g="100" b="180" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="大厂回族自治县委委员、常委" /><attvalue for="2" value="中共廊坊市大厂回族自治县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="回族" /><attvalue for="5" value="1974-04" /><attvalue for="6" value="百度百科杨华勇条目。男，回族，1974年4月出生，大厂回族自治县人，中央党校研究生学历，1997年8月入党，1995年9月参加工作。confidence=confirmed" /></attvalues></node><node id="8" label="王建民"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="廊坊市人大常委会副主任（原大厂县委书记）" /><attvalue for="2" value="廊坊市人民代表大会常务委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="百度百科王建民条目：2022年6月任大厂县委书记；2026年2月当选廊坊市人大常委会副主任。此前曾任大厂县委常委、副县长（2013年起）。confidence=confirmed" /></attvalues></node><node id="9" label="谷正海"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="已被开除党籍和公职（原大厂县委书记、廊坊市委常委）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1967-07" /><attvalue for="6" value="中央纪委国家监委网站通报。谷正海，男，汉族，1967年7月生，河北青县人，1989年8月参加工作，1995年11月入党，在职研究生学历，经济学博士。曾任大厂县委书记、廊坊市委常委、统战部长，2022年2月被查，2022年8月被双开。confidence=confirmed" /></attvalues></node><node id="10" label="邢云芳"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="大厂回族自治县人民政府副县长" /><attvalue for="2" value="大厂回族自治县人民政府" /><attvalue for="3" value="女" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="京东新城2024年6月报道：县长张秀萍、副县长邢云芳调研全为食品中央工厂。confidence=plausible" /></attvalues></node><node id="11" label="李建军"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue fo