<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="辛国勇"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="双滦区委书记" /><attvalue for="2" value="中共承德市双滦区委员会" /><attvalue for="3" value="未知" /><attvalue for="4" value="未知" /><attvalue for="6" value="双滦区人民政府官网新闻动态（2026-05-22『辛国勇主持召开区委理论学习中心组集中（扩大）学习会』、2026-05-28『区委常委会召开扩大会议』）多次确认辛国勇任双滦区委书记（区委理论学习中心组与区常委会由区委书记主持）。" /></attvalues></node><node id="2" label="王宇"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="双滦区委副书记、区政府区长、党组书记" /><attvalue for="2" value="承德市双滦区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1981年11月" /><attvalue for="6" value="双滦区人民政府—领导之窗（col11765）：王宇，男，汉族，1981年11月生，省委党校在职研究生，现任承德市双滦区委副书记、政府区长、党组书记。分工：负责区政府全面工作，分管区审计局。" /></attvalues></node><node id="3" label="宋超宇"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="双滦区委常委、副区长（常务）、党组副书记" /><attvalue for="2" value="承德市双滦区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1984年9月" /><attvalue for="6" value="双滦区人民政府—领导之窗（col11766）：宋超宇，男，汉族，1984年9月出生，省委党校研究生学历，中共党员，现任承德市双滦区委常委、副区长（分管政府常务工作）、党组副书记。分工：负责区政府常务工作，分管发改委、财政局、统计局、应急局、行政审批等。" /></attvalues></node><node id="4" label="王梓澳"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="双滦区副区长、党组成员" /><attvalue for="2" value="承德市双滦区人民政府" /><attvalue for="3" value="女" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1992年9月" /><attvalue for="6" value="双滦区人民政府—领导之窗（col11767）：女，汉族，1992年9月出生，省委党校研究生学历，中共党员，现任承德市双滦区人民政府副区长、党组成员。分工：教育体育、卫生健康、医疗保障等。" /></attvalues></node><node id="5" label="崔浩"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="双滦区副区长、党组成员、市公安分局党委书记、局长" /><attvalue for="2" value="承德市双滦区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1977年2月" /><attvalue for="6" value="双滦区人民政府—领导之窗（col11768）：男，汉族，1977年2月出生，中共河北省委党校研究生学历，中共党员，现任承德市双滦区人民政府副区长、党组成员、市公安局双滦分局党委书记、局长。分工：政法、稳定、司法、退役军人、公安交警。" /></attvalues></node><node id="6" label="王鹏程"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="双滦区副区长、党组成员" /><attvalue for="2" value="承德市双滦区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="未知" /><attvalue for="6" value="双滦区人民政府—领导之窗（col11769）：男，中共党员，现任承德市双滦区人民政府副区长、党组成员。分工：物流园区、住房和城乡建设、城市管理、交通运输、自然资源和规划。" /></attvalues></node><node id="7" label="陈志强"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="双滦区副区长、党组成员" /><attvalue for="2" value="承德市双滦区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="满族" /><attvalue for="5" value="1987年2月" /><attvalue for="6" value="双滦区人民政府—领导之窗（col11770）：男，满族，1987年2月出生，省委党校研究生学历，中共党员，现任承德市双滦区人民政府副区长、党组成员。分工：农业农村、商务、林业、水利、乡村振兴、文旅、文物。" /></attvalues></node><node id="8" label="高峰"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="双滦区副区长" /><attvalue for="2" value="承德市双滦区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1979年5月" /><attvalue for="6" value="双滦区人民政府—领导之窗（col12219）：男，汉族，1979年5月出生，本科大学学历，中共党员，现任承德市双滦区人民政府副区长。分工：工业信息化、生态环境保护、市场监管、中小企业、民营经济。" /></attvalues></node><node id="100001" label="中共承德市双滦区委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="承德市双滦区" /></attvalues></node><node id="100002" label="承德市双滦区人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级" /><attvalue for="9" value="承德市双滦区" /></attvalues></node><node id="100003" label="双滦区人民代表大会常务委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="人大" /><attvalue for="8" value="县级" /><attvalue for="9" value="承德市双滦区" /></attvalues></node><node id="100004" label="政协双滦区委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r=