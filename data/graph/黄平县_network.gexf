        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责教育、民族宗教、卫生健康、医疗保障、大健康、工会、妇女儿童等。兼任新州镇党委书记。"/>
        </attvalues>
