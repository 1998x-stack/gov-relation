    <edges>
      <edge id="e1" source="p1" target="o1" label="中共黄平县委书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持县委全面工作。经官方 2026-07-20、07-29 县委常委会报道确认在任。前任书记肖高峰 2026-07-10 仍在任，交接窗口为 2026-07-13 后、07-20 前。"/>
        </attvalues>
      </edge>
      <edge id="e2" source="p2" target="o1" label="中共黄平县委副书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="兼任县委副书记。2026-07 县委常委会出席名单在列。"/>
        </attvalues>
      </edge>
      <edge id="e3" source="p2" target="o2" label="黄平县人民政府县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持县人民政府全面工作，负责财政、审计、粮食方面工作；分管县财政局、县审计局。多次以县长身份调研、出席县委常委会。"/>
        </attvalues>
      </edge>
      <edge id="e4" source="p3" target="o1" label="黄平县委副书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="协助县委书记抓党的建设等工作。2026-07-29 县委常委会出席名单在列。"/>
        </attvalues>
      </edge>
      <edge id="e5" source="p4" target="o1" label="黄平县委副书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="2026-07-10（肖高峰主持）县委常委会出席名单在列；是否仍在任待查。"/>
        </attvalues>
      </edge>
      <edge id="e6" source="p5" target="o2" label="黄平县委常委、常务副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责县政府常务工作；县委常委会成员。负责财政、发改、金融、应急等工作（主管领域见官方领导之窗分工）。"/>
        </attvalues>
      </edge>
      <edge id="e7" source="p6" target="o2" label="黄平县委常委、副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责农业、水务、林业、乡村振兴、易地搬迁、脱贫成果巩固等（官方领导之窗分工）。"/>
        </attvalues>
      </edge>
      <edge id="e8" source="p6" target="o1" label="黄平县委常委" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="县委常委会成员。"/>
        </attvalues>
      </edge>
      <edge id="e9" source="p7" target="o2" label="黄平县人民政府党组成员、副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责民政、人力资源、社会保障、文旅、体育、广电、残疾人事业等。"/>
        </attvalues>
      </edge>
      <edge id="e10" source="p8" target="o2" label="黄平县人民政府党组成员、副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责公安、国安、司法、退役军人事务、维护稳定、信访、禁毒等；主持县公安局全面工作。"/>
        </attvalues>
      </edge>
      <edge id="e11" source="p8" target="o3" label="黄平县公安局党委书记、局长、督查长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持县公安局全面工作。"/>
        </attvalues>
      </edge>
      <edge id="e12" source="p9" target="o2" label="黄平县人民政府党组成员、副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责工业和信息化、商务、民营经济、市场监管、招商引资、营商环境、政务服务、驻外联络等。"/>
        </attvalues>
      </edge>
