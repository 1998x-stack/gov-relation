<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="张硕"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="青县县委书记（2026-01 起，约2026-07 调任黄骅市市长）" /><attvalue for="2" value="中共青县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1980-03" /><attvalue for="6" value="百度百科-张硕(河北省沧州市青县县委书记)：1980年3月生，河北保定人，2003年6月入党、2003年8月参加工作，全日制大学学历、公共管理硕士；2026-01-10 青县县委书记——沧州市财政局原党委书记、局长张硕履新（望海司微博/汲古新知 2026-02-07）；2026-07-29 燕阵沧州-人事快讯：张硕任黄骅市人民政府市长。" /></attvalues></node><node id="2" label="李向伟"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="青县人民政府副县长、代理县长" /><attvalue for="2" value="青县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="青县2026年最新任命(爱企查)：2026-05-20 青县第十八届人大常委会第四十次会议决定任命李向伟为青县副县长并决定其代理青县县长，同时接受时励辞去县长；百度百科-李向伟(青县代理县长)。此前任大城县人民政府副县长（2022-08-30 大城县人大常委会第十次会议任命）。" /></attvalues></node><node id="3" label="时励"><viz:size value="50.0" /><viz:shape value="circle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="原青县人民政府县长（2026-05-20 辞职，另有任用）" /><attvalue for="2" value="青县人民政府（已卸任）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1982-07" /><attvalue for="6" value="百度百科-时励：1982年7月生，河北武强人，河北经贸大学法学；2021-06 任青县副县长、代县长，2021-07-28 当选县长（青县十八届人大一次会议）；2026-05-20 青县十八届人大常委会第四十次会议接受其辞去青县县长。青县2026年政府工作报告（2026-02-11）由县长时励署名。" /></attvalues></node><node id="4" label="左亚宁"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="原青县县委书记（2026-01 离任；据报任黄骅市委副书记、代理市长）" /><attvalue for="2" value="中共青县委员会（已卸任）" /><attvalue for="3" value="男" /><attvalue for="4" value="待查" /><attvalue for="6" value="搜狐网-沧州人事任免：2022-12-15 青县召开全县领导干部会议，省委、市委决定左亚宁任中共青县县委书记；百度文库-青县领导干部调整：左亚宁曾任肃宁县副县长、肃宁县委常委办公室主任、东光县委常委常务副县长；汲古新知/望江司(2026-01-10)：左亚宁不再担任青县县委书记，据报任黄骅市委副书记、代理市长。" /></attvalues></node><node id="5" label="张卫忠"><viz:size value="30.0" /><viz:shape value="diamond" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="青县人大常委会主任" /><attvalue for="2" value="青县人民代表大会常务委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="青县第十八届人大常委会第五次(2022-01-19)/第三十七次(2026-01-30)/第四十次会议均由主任张卫忠主持（官方发布）。" /></attvalues></node><node id="6" label="马俊敏"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="青县县委常委、纪委书记、监委主任" /><attvalue for="2" value="中共青县纪律检查委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="青县十八届人大常委会第五次会议(2022-01-19)：县委常委、纪委书记、监委主任马俊敏列席（官方发布）。" /></attvalues></node><node id="7" label="韩尚龙"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="青县人民政府副县长（2026-01-13 任命）" /><attvalue for="2" value="青县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="青县第十八届人大常委会第三十七次会议(2026-01-30)：副县长韩尚龙列席；爱企查-青县2026年最新任命：2026-01-13 决定任命韩尚龙为青县副县长，同时免去曾宪强的副县长职务。" /></attvalues></node><node id="8" label="李国钧"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="原青县县委书记（约2021-2022，后任辛集市委书记）" /><attvalue for="2" value="中共青县委员会（已卸任）" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="网易新闻(2022-12-29)：李国钧曾为青县县委书记，2022-11 已任辛集市委书记；“书记项目”专访播出青县县委书记李国钧(2021-11)。青县县委常委会(扩大)会议(2023-11-21 青县政府)等仍以李国钧为书记出席。" /></attvalues></node><node id="100001" label="中共青县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="沧州市青县" /></attvalues></node><node id="100002" label="青县人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级" /><attvalue for="9" value="沧州市青县" /></attvalues></node><node id="100003" label="青县人民代表大会常务委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="人大" /><attvalue for="8" value="县级" /><attvalue for="9" value="沧州市青县" /></attvalues></node><node id="100004" label="中共青县纪律检查委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="群团（纪检）" /><attvalue for="8" value="县级" /><attvalue for="9" value="沧州市青县" /></attvalues></node><node id="100005" label="政协青县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政协" /><attvalue for="8" value="县级" /><attvalue for="9" value="沧州市青县" /></attvalues></node><node id="100006" label="青县经济开发区管理委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="开发区" /><attvalue for="8" value="县级" /><attvalue for="9" value="沧州市青县" /></attvalues></node><node id="100007" label="沧州市财政局"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="市级" /><attvalue for="9" value="沧州市" /></attvalues></node><node id="100008" label="沧州渤海新区管理委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="开发区" /><attvalue for="8" value="市级（国家级新区）" /><attvalue for="9" value="沧州市" /></attvalues></node><node id="100009" label="沧州渤海新区黄骅市港城产业园区"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="开发区" /><attvalue for="8" value="县级" /><attvalue for="9" value="沧州市黄骅市" /></attvalues></node><node id="100010" label="黄骅市人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级（县级市）" /><attvalue for="9" value="沧州市黄骅市" /></attvalues></node><node id="100011" label="大城县人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级" /><attvalue for="9" value="廊坊市大城县" /></attvalues></node></nodes><edges><edge id="1" source="1" target="2"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="张硕（书记，2026-01 任）与李向伟（代县长，2026-05-20 任）为青县党政一把手搭档（书记-县长（代））的依据：二者任职期重叠（2026-05/2026-07）。" /><attvalue for="2" value="青县县委／青县人民政府" /><attvalue for="3" value="2026-05/2026-07" /></attvalues></edge><edge id="2" source="1" target="3"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="张硕 2026-01 任青县县委书记，与县长时励（2021-2026-05）在 2026-01～2026-05 期间为书记-县长搭档。" /><attvalue for="2" value="青县县委／青县人民政府" /><attvalue for="3" value="2026-01—2026-05" /></attvalues></edge><edge id="3" source="3" target="2"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="时励 2026-05-20 辞去青县长，李向伟同日被任命为代理县长（前任-继任）。" /><attvalue for="2" value="青县人民政府" /><attvalue for="3" value="2026-05-20" /></attvalues></edge><edge id="4" source="4" target="1"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="左亚宁 2022-12～2026-01 任青县县委书记，张硕 2026-01 接任县委书记（前一前者-继任者）。" /><attvalue for="2" value="青县县委" /><attvalue for="3" value="2026-01" /></attvalues></edge><edge id="5" source="1" target="5"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="县委书记张硕与人大主任张卫忠共同出席县里重要会议/政法班子（张卫忠多次主持人大，张书记2026-01后主持县委）。" /><attvalue for="2" value="青县县委／青县人大" /><attvalue for="3" value="2026-01/2026-07" /></attvalues></edge><edge id="6" source="3" target="5"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="县长时励与人大主任张卫忠：政府工作报告提交人代会审议等体制内常态互动。" /><attvalue for="2" value="青县政府／青县人大" /><attvalue for="3" value="2021/2026" /></attvalues></edge><edge id="7" source="3" target="6"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="县长时励与纪委书记马俊敏同属青县党政班子，于 2021-2026 共同任职。" /><attvalue for="2" value="青县县委" /><attvalue for="3" value="2022-01/2026-05" /></attvalues></edge><edge id="8" source="4" target="3"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="左亚宁（书记2022-12～2026-01）与时励（县长2021-06～2026-05）为青县书记-县长搭档，两人期间共同主持县常委会等。" /><attvalue for="2" value="青县县委／青县人民政府" /><attvalue for="3" value="2023-2026-01" /></attvalues></edge></edges></graph><meta><title>青县</title></meta></gexf>