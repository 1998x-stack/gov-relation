<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="孟凡雄"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="邯郸市曲周县委书记" /><attvalue for="2" value="中共曲周县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="基于公开报道，孟凡雄约2021年起任曲周县委书记。因网络受限无法从官方网站或百度百科直接核实最新在任情况。置信度：plausible。建议访问 www.quzhou.gov.cn 领导之窗核实。" /></attvalues></node><node id="2" label="李冬晨"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="曲周县委副书记、县政府县长" /><attvalue for="2" value="曲周县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="基于公开报道，李冬晨约2023年起任曲周县委副书记、县长。因网络受限无法从官方网站核实最新在任情况。置信度：plausible。建议访问曲周县人民政府网站核实。" /></attvalues></node><node id="3" label="县委副书记（姓名待查）"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="曲周县委副书记（专职）" /><attvalue for="2" value="中共曲周县委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="信息缺失。常规设置：每县设有1名专职副书记，常分管党建、农业农村、政法等工作。需访问曲周县政府网站领导之窗核实具体人选。" /></attvalues></node><node id="4" label="县政府常务副县长（姓名待查）"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="曲周县委常委、县政府常务副县长" /><attvalue for="2" value="曲周县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="信息缺失。常规设置：每县设1名常务副县长，协助县长主持县政府日常工作。需访问曲周县政府网站核实具体人选。" /></attvalues></node><node id="5" label="县纪委书记（姓名待查）"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="曲周县委常委、县纪委书记、县监委主任" /><attvalue for="2" value="中共曲周县纪律检查委员会/曲周县监察委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="信息缺失。需访问曲周县政府网站领导之窗核实具体人选。" /></attvalues></node><node id="6" label="李凡（前任县委书记）"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="待查（原曲周县委书记）" /><attvalue for="3" value="待查" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="李凡约2018-2021年任曲周县委书记，后孟凡雄接任。具体去向待查。置信度：plausible。" /></attvalues></node><node id="100001" label="中共曲周县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市曲周县" /></attvalues></node><node id="100002" label="曲周县人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市曲周县" /></attvalues></node><node id="100003" label="曲周县人大常委会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="人大" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市曲周县" /></attvalues></node><node id="100004" label="曲周县政协"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政协" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市曲周县" /></attvalues></node><node id="100005" label="中共曲周县纪律检查委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市曲周县" /></attvalues></node></nodes><edges><edge id="1" source="1" target="2"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="孟凡雄为县委书记，李冬晨为县长，县核心领导搭档" /><attvalue for="2" value="中共曲周县委员会/曲周县人民政府" /><attvalue for="3" value="约2023-" /></attvalues></edge><edge id="2" source="1" target="3"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="孟凡雄作为县委书记领导县委副书记" /><attvalue for="2" value="中共曲周县委员会" /><attvalue for="3" value="未知-present" /></attvalues></edge><edge id="3" source="2" target="4"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="李冬晨为县长，分管县政府常务工作" /><attvalue for="2" value="曲周县人民政府" /><attvalue for="3" value="未知-present" /></attvalues></edg