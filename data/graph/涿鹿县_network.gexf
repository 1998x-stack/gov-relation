alue="汉族" /><attvalue for="5" value="1967年4月" /><attvalue for="6" value="`build_万全区_data.py`：赵满柱为 河北涿鹿人，1967-04，研究生，1987-08入党；曾任万全区委书记（撤县设区前万全县委书记）、张家口市政协副主席。涿鹿籍干部在张仮口市域晋升的先例节点。" /></attvalues></node><node id="17" label="赵文锋"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="张家口市委书记" /><attvalue for="2" value="中共张家口市委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="`_report/20260805-河北省-张家口市-阳原县-领导班子工作关系调查报告.md` 确认赵文锋为张家口市委书记；涿鹿县委受其领导体系管辖。" /></attvalues></node><node id="100001" label="中共涿鹿县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="张家口市涿鹿县" /></attvalues></node><node id="100002" label="涿鹿县人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级" /><attvalue for="9" value="张家口市涿鹿县" /></attvalues></node><node id="100003" label="涿鹿县人民代表大会常务委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="人大" /><attvalue for="8" value="县级" /><attvalue for="9" value="张家口市涿鹿县" /></attvalues></node><node id="100004" label="中国人民政治协商会议涿鹿县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政协" /><attvalue for="8" value="县级" /><attvalue for="9" value="张家口市涿鹿县" /></attvalues></node><node id="100005" label="中共涿鹿县纪律检查委员会/监委"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="