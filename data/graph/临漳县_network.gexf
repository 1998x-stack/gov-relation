<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="县委书记（姓名待确认）"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="临漳县委书记" /><attvalue for="2" value="中共临漳县委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="临漳县委书记现任姓名在本会话内未能经公开检索核实（县级干部任免信息散见于市政府与县政府网站，均超时/受限）。按正常运行惯例为中共临漳县委书记。置信度：unverified。建议后续访问 www.lzx.gov.cn 领导之窗或邯郸市委组织部任前公示核实。" /></attvalues></node><node id="2" label="县长（姓名待确认）"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="临漳县委副书记、县政府县长" /><attvalue for="2" value="临漳县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="临漳县县长在本会话内未能经公开检索核实姓名。通常由临漳县人民政府官网领导之窗或临漳县人大任命公告确认。置信度：unverified。" /></attvalues></node><node id="3" label="县委专职副书记（姓名待核）"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="临漳县委副书记（专职）" /><attvalue for="2" value="中共临漳县委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="信息缺失。常规设置：每县设1名专职副书记，常分管党建、农业农村、政法。需访问临漳县政府网站领导之窗核实具体人选。" /></attvalues></node><node id="4" label="县政府常务副县长（姓名待核）"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="临漳县委常委、县政府常务副县长" /><attvalue for="2" value="临漳县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="信息缺失。常规设置：每县设1名常务副县长协助县长主持县政府日常工作。需访问临漳县政府网站核实具体人选。" /></attvalues></node><node id="5" label="县纪委书记（姓名待核）"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="临漳县委常委、县纪委书记、县监委主任" /><attvalue for="2" value="中共临漳县纪律检查委员会/临漳县监察委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="信息缺失。需访问临漳县政府网站领导之窗核实具体人选。" /></attvalues></node><node id="6" label="边飞"><viz:size value="20.0" /><viz:shape value="circle" /><viz:color r="180" g="180" b="180" a="0.7" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="无（因违纪违法接受审查，2013年后被处理）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族（推测）" /><attvalue for="5" value="待查" /><attvalue for="6" value="本项目本地履历库 confirmed：曾任曲周县委书记、临漳县委书记、魏县县委书记、永年县委书记，后任邯郸市委常委兼大名县委书记，2013年被调查后被判无期徒刑。来源：scripts/build/build_大名县_data.py（person_id 8）、build_永年区_data.py。" /></attvalues></node><node id="7" label="马洪广"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="邯郸市永年区委书记" /><attvalue for="2" value="中共邯郸市永年区委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="本地履历库（build_永年区_data.py id 1）confirmed：磁县林坦镇→临漳县委（农工委、宣传部长兼统战部长）→成安县委常委、组织部长→鸡泽县长提名→广平县委书记→永年区委书记。本条目聚焦其临漳县委任职经历。" /></attvalues></node><node id="8" label="李少锋"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="邯郸市审计局局长（2026年起，复兴区前任区委书记）" /><attvalue for="2" value="邯郸市审计局" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1969年11月" /><attvalue for="6" value="本地履历库 confirmed：籍贯临漳县，临漳本地干部，早年在临漳工作；2021-05~2026任复兴区委书记，2026 调任市审计局局长。来源：build_复兴区_data.py、report/open_gaps.md(2026-08-05 resolved)。本条目聚焦其临漳籍贯与早期工作。" /></attvalues></node><node id="100001" label="中共临漳县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市临漳县" /></attvalues></node><node id="100002" label="临漳县人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市临漳县" /></attvalues></node><node id="100003" label="临漳县人大常委会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="人大" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市临漳县" /></attvalues></node><node id="100004" label="临漳县政协"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政协" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市临漳县" /></attvalues></node><node id="100005" label="中共临漳县纪律检查委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市临漳县" /></attvalues></node></nodes><edges><edge id="1" source="1" target="2"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="临漳县委书记与县长，县核心领导搭档（占位，具体人名待核实）" /><attvalue for="2" value="中共临漳县委员会/临漳县人民政府" /><attvalue for="3" value="待查" /></attvalues></edge><edge id="2" source="1" target="3"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="县委书记领导专职县委副书记" /><attvalue for="2" value="中共临漳县委员会" /><attvalue for="3" value="未知-present" /></attvalues></edge><edge id="3" source="2" target="4"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="县长领导县政府常务工作" /><attvalue for="2" value="临漳县人民政府" /><attvalue for="3" value="未知-present" /></attvalues></edge><edge id="4" source="1" target="5"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="县委书记领导纪委监委工作" /><attvalue for="2" value="中共临漳县委员会" /><attvalue for="3" value="未知-present" /></attvalues></edge><edge id="5" source="6" target="1"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="边飞曾任临漳县委书记；现任县委书记（待确认）为后续接任者之一。历史关系，链路待核实。" /><attvalue for="2" value="中共临漳县委员会" /><attvalue for="3" value="跨不同时期" /></attvalues></edge><edge id="6" source="7" target="1"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="马洪广曾任临漳县委宣传部长兼统战部长，属临漳县级常委序列（占位书记为其时任领导）" /><attvalue for="2" value="中共临漳县委员会" /><attvalue for="3" value="约2003-2011" /></attvalues></edge></edges></graph><meta><title>临漳县</title></meta></gexf>