ape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="海兴县委常委、常务副县长" /><attvalue for="2" value="海兴县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="海兴县政府官网—领导之窗：县委常委、副县长柳杨，负责县政府常务工作，分管发改、财税、统计、应急、信访等，协助刘洋同志分管县审计局。" /></attvalues></node><node id="4" label="鞠海洪"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="海兴县委常委、副县长（挂职）" /><attvalue for="2" value="海兴县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="海兴县政府官网—领导之窗：县委常委、副县长鞠海洪（挂职），协助杜鑫麟同志抓好乡村振兴，协助赵海涛同志抓好对外开放和招商引资工作。" /></attvalues></node><node id="5" label="高德强"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="海兴县副县长" /><attvalue for="2" value="海兴县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="海兴县政府官网—领导之窗：副县长高德强，负责数据、审批、市场监管、教育、卫生、医保、金融等。" /></attvalues></node><node id="6" label="王文德"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="海兴县副县长" /><attvalue for="2" value="海兴县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="海兴县政府官网—领导之窗：副县长王文德，负责城乡建设、自然资源和规划、交通运输等。" /></attvalues></node><node id="7" label="李一兵"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="海兴县副县长（分管公安）" /><attvalue for="2" value="海兴县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="海兴县政府官网—领导之窗：副县长李一兵，负责公安、司法、退役军人事务等工作，分管县公安局、县司法局、县退役军人事务局。" /></attvalues></node><node id="8" label="杜鑫麟"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="海兴县副县长" /><attvalue for="2" value="海兴县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="海兴县政府官网—领导之窗：副县长杜鑫麟，负责农业农村、乡村振兴、水务等工作。" /></attvalues></node><node id="9" label="赵海涛"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="海兴县副县长" /><attvalue for="2" value="海兴县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="海兴县政府官网—领导之窗：副县长赵海涛，负责工业和信息化、科技、商务、招商引资、对外开放、生态环境等工作。" /></attvalues></node><node id="10" label="杨伟东"><viz:size value="20.0" /><viz:shape value="circle" /><viz:color r="180" g="180" b="180" a="0.7" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="海兴县人民政府党组成员" /><attvalue for="2" value="海兴县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="6" value="海兴县政府官网—领导之窗：党组成员杨伟东，协助柳杨同志负责国有资产管理工作，分管县建投公司、县兴港公司。" /></attvalues></node><node id="100001" label="中共海兴县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="沧州市海兴县" /></attvalues></node><node id="100002" label="海兴县人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级" /><attvalue for="9" value="沧州市海兴县" /></attvalues></node><node id="100003" label="海兴县人民代表大会常务委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue f