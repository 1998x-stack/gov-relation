<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="吴杰"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委书记" /><attvalue for="2" value="中共虞城县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1976-10" /><attvalue for="6" value="Confirmed 虞城县委书记 (2026-05起). 2026-04-20任前公示 '现任柘城县委副书记、县长,拟任县(市、区)委书记'. 曾任宁陵县委常/县委办主任、柘城县委常/常务副县长、柘城县委副书记/县长(2025-01当选). 2026-06虞城县第十四次党代会主席团首位." /></attvalues></node><node id="2" label="蒋验军"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委副书记、县长" /><attvalue for="2" value="虞城县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1985-08" /><attvalue for="6" value="Confirmed: 2023-11-20任前公示'虞城县委常、闻集镇党委书记,拟任县(市、区)长候选人,1985-08,研究生法学硕士'; 2023-12代县长; 2024-03-29县十六届人大四次会议当选县长; 2026年在任." /></attvalues></node><node id="3" label="何玉东"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="商丘市政协副主席（原虞城县委书记）" /><attvalue for="2" value="商丘市政协" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1968-01" /><attvalue for="6" value="Confirmed: 2023-05-17任虞城县委书记; 任内兼商丘市政协副主席; 曾任梁园区乡镇党委书记、梁园区副区长、商丘市工信局副局长(2021-08)、商丘市乡村振兴局党组书记/主任(2022-08). 2026年卸任虞城书记(吴杰接), 现任职务待查." /></attvalues></node><node id="4" label="班春丽"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委副书记" /><attvalue for="2" value="中共虞城县委员会" /><attvalue for="3" value="女" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1970-07" /><attvalue for="6" value="Confirmed via 2023-03-06任前公示'1970-07生,女,中专,现任虞城县委副书记/三级调研员,拟任县长候选人'; 后仍任县委副书记. 2016-2022曾任副县长、常务副县长." /></attvalues></node><node id="5" label="孙虎"><viz:size value="50.0" /><viz:shape value="circle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="（原虞城县县长）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="6" value="Confirmed: 2022-04-26十六届人大一次会议当选虞城县县长; 2021-12已以县长身份活动(人民日报中国品牌论坛). 2023-11蒋验军接任代县长, 孙虎卸任, 去向未确认." /></attvalues></node><node id="100001" label="中共虞城县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县处级" /><attvalue for="9" value="虞城县" /></attvalues></node><node id="100002" label="虞城县人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县处级" /><attvalue for="9" value="虞城县" /></attvalues></node><node id="100003" label="虞城县人民代表大会常务委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="人大" /><attvalue for="8" value="县处级" /><attvalue for="9" value="虞城县" /></attvalues></node><node id="100004" label="中国人民政治协商会议虞城县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政协" /><attvalue for="8" value="县处级" /><attvalue for="9" value="虞城县" /></attvalues></node><node id="100005" label="虞城县纪律检查委员会、监察委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="纪委" /><attvalue for="8" value="县处级" /><attvalue for="9" value="虞城县" /></attvalues></node><node id="100006" label="商丘市人大常委会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="人大" /><attvalue for="8" value="地级市" /><attvalue for="9" value="商丘市" /></attvalues></node><node id="100007" label="中共商丘市委"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="地级市" /><attvalue for="9" value="商丘市" /></attvalues></node><node id="100008" label="商丘市人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="地级市" /><attvalue for="9" value="商丘市" /></attvalues></node><node id="100009" label="中共柘城县委"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县处级" /><attvalue for="9" value="柘城县" /></attvalues></node><node id="100010" label="柘城县人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县处级" /><attvalue for="9" value="柘城县" /></attvalues></node><node id="100011" label="商丘市政协"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政协" /><attvalue for="8" value="地级市" /><attvalue for="9" value="商丘市" /></attvalues></node><node id="100012" label="中共宁陵县委"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县处级" /><attvalue for="9" value="宁陵县" /></attvalues></node><node id="100013" label="中共梁园区委"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="副厅级" /><attvalue for="9" value="商丘市梁园区" /></attvalues></node><node id="100014" label="商丘市工业和信息化局"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府机关" /><attvalue for="8" value="正处级" /><attvalue for="9" value="商丘市" /></attvalues></node><node id="100015" label="商丘市乡村振兴局"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府机关" /><attvalue for="8" value="正处级" /><attvalue for="9" value="商丘市" /></attvalues></node><node id="100016" label="虞城县闻集镇党委、政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="乡镇/街道" /><attvalue for="8" value="乡科级" /><attvalue for="9" value="虞城县闻集镇" /></attvalues></node></nodes><edges><edge id="1" source="1" target="2"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="吴杰（县委书记）与蒋验军（县委副书记、县长）为虞城全县党政正职搭档，共同主持县委县政府工作（2026-06 重点项目调研、2026-07 八一慰问等多次同场）。" /><attvalue for="2" value="虞城县" /><attvalue for="3" value="2026-05至今" /></attvalues></edge><edge id="2" source="1" target="3"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="何玉东 2026-04 卸任虞城县委书记，吴杰接任（2026-05），由商丘市委主导任免交接。" /><attvalue for="2" value="中共虞城县委员会" /><attvalue for="3" value="2026-05" /></attvalues></edge><edge id="3" source="3" target="2"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="何玉东任虞城县委书记（2023-05~2026-04）期间，与县委副书记、县长蒋验军（2024起）为党政正职搭档。" /><attvalue for="2" value="虞城县" /><attvalue for="3" value="2024-2026" /></attvalues></edge><edge id="4" source="2" target="5"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="孙飞 2021~2023任虞城县长，蒋验军 2023-11 公示候任代县长接任。" /><attvalue for="2" value="虞城县人民政府" /><attvalue for="3" value="2023-11" /></attvalues></edge><edge id="5" source="4" target="2"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="班春丽 2023-03 公示拟任县长候选人未获任；蒋验军 2023-11 获任代县长，同一县长职务交替。" /><attvalue for="2" value="虞城县" /><attvalue for="3" value="2023" /></attvalues></edge><edge id="6" source="1" target="3"><attvalues><attvalue for="0" value="cross_county" /><attvalue for="1" value="吴杰（宁陵→柘城→虞城）与何玉东（梁园区→市直→虞城）同属商丘市委辖下跨县/市直多岗位轮换的县处级正职领导线路。" /><attvalue for="2" value="中共商丘市委" /><attvalue for="3" value="2026" /></attvalues></edge><edge id="7" source="2" target="4"><attvalues><attvalue for="0" value="same_org" /><attvalue for="1" value="蒋验军（县长）与班春丽（县委副书记）同届虞城县党政班子共事。" /><attvalue for="2" value="虞城县" /><attvalue for="3" value="2023-至今" /></attvalues></edge></edges></graph><meta><title>虞城县</title></meta></gexf>