<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="栗团结"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委书记" /><attvalue for="2" value="中共宁陵县委员会" /><attvalue for="6" value="Confirmed via official government news: 2026-06-25 article '县委书记栗团结深入乡镇调研'. Previously served as 宁陵县长 (confirmed via 2025-12-31 article '县长栗团结到县群众服务中心公开接访' and 2025-12-30 '县长栗团结出席经济运行调度会'). Promoted from 县长 to 县委书记 between Jan and June 2026." /></attvalues></node><node id="2" label="待查（县长）"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委副书记、县长（姓名待查）" /><attvalue for="2" value="宁陵县人民政府" /><attvalue for="6" value="Current 宁陵县长 identity unverified. 栗团结 was previously 县长 (confirmed through 2025-12 articles) and has been promoted to 县委书记 (~June 2026). The new 县长 or 代县长 has not been identified from available news articles. Needs targeted search or government leadership page access." /></attvalues></node><node id="3" label="董俊山"><viz:size value="30.0" /><viz:shape value="diamond" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县人大常委会主任" /><attvalue for="2" value="宁陵县人民代表大会常务委员会" /><attvalue for="6" value="Confirmed via 2026-07-23 official article: '宁陵县人大常委会主任董俊山调研惠宁理想新城项目建设情况'." /></attvalues></node><node id="4" label="卢泓亦"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、常务副县长" /><attvalue for="2" value="宁陵县人民政府" /><attvalue for="6" value="Confirmed via multiple official articles: 2026-03-23 '县委常委、常务副县长卢泓亦' (政银企对接会); 2026-01-28 '县委常委、常务副县长卢鸿亦' (全县金融系统工作会议). Note: name appears as 卢泓亦 (2026-03) and 卢鸿亦 (2026-01), likely the same person." /></attvalues></node><node id="5" label="岳德熙"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、政法委书记" /><attvalue for="2" value="中共宁陵县委员会" /><attvalue for="6" value="Confirmed via 2025-12-29 official article: '县委常委、政法委书记岳德熙参加接访'." /></attvalues></node><node id="6" label="陈苏豫"><viz:size value="20.0" /><viz:shape value="circle" /><viz:color r="180" g="180" b="180" a="0.7" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县领导（具体职务待查）" /><attvalue for="2" value="宁陵县" /><attvalue for="6" value="Mentioned in 2026-06-25 article as '县领导陈苏豫、司维参加' accompanying 县委书记栗团结 in investigation." /></attvalues></node><node id="7" label="司维"><viz:size value="20.0" /><viz:shape value="circle" /><viz:color r="180" g="180" b="180" a="0.7" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县领导（具体职务待查）" /><attvalue for="2" value="宁陵县" /><attvalue f