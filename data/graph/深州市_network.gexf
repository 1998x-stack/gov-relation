tvalues></edge><edge id="9" source="15" target="16"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="于波接任前任市委书记王文强任深州市委书记（王文强2019-2021，于波2022-）。" /><attvalue for="2" value="中共深州市委员会" /><attvalue for="3" value="2021-2022" /></attvalues></edge><edge id="10" source="17" target="15"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="于波接任前任市长张小勇任市长（张小勇2018-2020，于波2021-2022）。" /><attvalue for="2" value="深州市人民政府" /><attvalue for="3" value="2020-2021" /></attvalues></edge><edge id="11" source="16" target="18"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="王文强接任前任市委书记刘继承（2018-2019）任书记。" /><attvalue for="2" value="中共深州市委员会" /><attvalue for="3" value="2019" /></attvalues></edge><edge id="12" source="3" target="15"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="严立根（市人大主任）与于波（前书记/前市长）均在深州市委/人大班子共事（2018-2025）。" /><attvalue for="2" value="中共深州市委员会／深州市人大常委会" /><attvalue for="3" value="2018-2025" /></attvalues></edge><edge id="13" source="5" target="4"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="人大常委会副主任李会选、张会强等在同一届人大常委会集体的共事（人大副主任集体）。" /><attvalue for="2" value="深州市人民代表大会常务委员会" /><attvalue for="3" value="2021-" /></attvalues></edge><edge id="14" source="8" target="3"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="市纪委、市监委主任张占增与人大主任严立根在人大常委会履职程序上分工协作（人大选举监委主任）。" /><attvalue for="2" value="深州市人大常委会／中共深州市纪委" /><attvalue for="3" value="2023-" /></attvalues></edge></edges></graph><meta><title>深州市</title></meta></gexf>