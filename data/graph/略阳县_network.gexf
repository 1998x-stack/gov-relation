<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="郭华"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委书记（待核验）" /><attvalue for="2" value="中共略阳县委员会" /><attvalue for="6" value="UNVERIFIED：本环境（略县政府官网/人民网地方领导库被阻断；市组织部任前公示未获得）未能核实现任县委书记。据既有培训记忆，略阳县委书记约2021-2024 为【郭华】（此前任略阳县长/县委副书记），2026 年是否仍在任未确认。见 open_gaps/郭华 person 档." /></attvalues></node><node id="2" label="刘文荣"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委副书记、县长" /><attvalue for="2" value="略阳县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1974-09" /><attvalue for="6" value="略阳县政府官网 领导之窗 2026-01-08；县食药安委（扩大）会 2026-08-06；苏货协作访海安 2026-07。曾任市委人才办副主任、市政府副秘书长、市政府办公室党组成员/机关党组成员。" /></attvalues></node><node id="3" label="康雄"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、常务副县长、县政府党组副书记" /><attvalue for="2" value="略阳县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1980-01" /><attvalue for="6" value="略阳县政府官网 领导之窗。曾任市直部门副主任/副局长，县（区）委常委、统战部部长，组织部部长。" /></attvalues></node><node id="4" label="任帅"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、副县长" /><attvalue for="2" value="略阳县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1972-12" /><attvalue for="6" value="略阳县政府官网 领导之窗。曾任乡镇乡长、镇长、镇党委书记、人大主席（兼）、县委组织部副部长、县委人才办主任（兼）、五龙洞国家森林公园党工委书记等。" /></attvalues></node><node id="5" label="陈国东"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、副县长、县政府党组成员" /><attvalue for="2" value="略阳县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1973-10" /><attvalue for="6" value="略阳县政府官网 领导之窗。曾任国家国防科技工业局新闻宣传中心综合新闻宣传处六级职员，北京军工宏图文化传播公司副总经理、党支部书记等。" /></attvalues></node><node id="6" label="曹斌"><viz:size value="30.0" /><viz:shape value="circle" /><viz:color r="180" g="100" b="180" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、县政府党组成员" /><attvalue for="2" value="略阳县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1978-09" /><attvalue for="6" value="领导之窗。曾任县直部门副局长、局长、党组书记，市直单位副主任，县委常委、街道党工委书记等。" /></attvalues></node><node id="7" label="王桂林"><viz:size value="35.0" /><viz:shape value="triangle" /><viz:color r="100" g="150" b="220" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="副县长、县政府党组成员" /><attvalue for="2" value="略阳县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1973-06" /><attvalue for="6" value="领导之窗。" /></attvalues></node><node id="8" label="郑莉"><viz:size value="35.0" /><viz:shape value="triangle" /><viz:color r="100" g="150" b="220" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="副县长、县政府党组成员" /><attvalue for="2" value="略阳县人民政府" /><attvalue for="3" value="女" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1980-09" /><attvalue for="6" value="领导之窗。曾任团县委书记、乡镇镇长、镇党委书记、县部门党组书记、局长等。" /></attvalues></node><node id="9" label="李娜"><viz:size value="35.0" /><viz:shape value="triangle" /><viz:color r="100" g="150" b="220" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="副县长" /><attvalue for="2" value="略阳县人民政府" /><attvalue for="3" value="女" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1981-01" /><attvalue for="6" value="领导之窗。曾任市级部门单位负责人。" /></attvalues></node><node id="10" label="彭冲"><viz:size value="35.0" /><viz:shape value="triangle" /><viz:color r="100" g="150" b="220" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="副县长、县政府党组成员" /><attvalue for="2" value="略阳县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1975-02" /><attvalue for="6" value="领导之窗。曾任乡村副镇长、乡党委副书记、乡长，镇党委书记，县直部门党组书记、局长等。" /></attvalues></node><node id="11" label="汉中市委书记 张烨 (context)"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="汉中市委书记 (context)" /><attvalue for="2" value="中共汉中市委" /><attvalue for="6" value="本仓库《汉中市 市委书记市长-前任继任与跨地交流报告》(2026-08-07)，张烨 2023-03 起任汉中市委书记。" /></attvalues></node><node id="200001" label="中共略阳县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" 