<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="徐艳刚"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="柏乡县委书记（待确认是否仍在任）" /><attvalue for="2" value="中共柏乡县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="unverified。徐艳刚约于2021-2022年任柏乡县委书记。2024-2026年期间是否仍在该岗位未知。未找到简历来源。" /></attvalues></node><node id="2" label="待查（县长）"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="柏乡县委副书记、县长" /><attvalue for="2" value="柏乡县人民政府" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="unverified。县长姓名待查。此前曾有报道提及柏乡县长人选但当前在任者未知。" /></attvalues></node><node id="3" label="王涛"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="待查（已离任柏乡县委书记）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="unverified。王涛约于2018年至2021年任柏乡县委书记。去向：可能调任邢台市市直部门或其他县市。" /></attvalues></node><node id="4" label="张万双"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="待查（已离任柏乡县委书记）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="unverified。张万双约于2015年至2018年任柏乡县委书记。" /></attvalues></node><node id="5" label="李振军"><viz:size value="20.0" /><viz:shape value="circle" /><viz:color r="180" g="180" b="180" a="0.7" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="待查（已离任柏乡县职务）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="unverified。李振军曾任柏乡县委书记，具体任期待查。注意：邢台市信都区也有一位李振军（曾任桥西区长），是否同一人需核实。" /></attvalues></node><node id="6" label="县委副书记（待查）"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="柏乡县委副书记" /><attvalue for="2" value="中共柏乡县委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="unverified。县委副书记姓名待查。" /></attvalues></node><node id="7" label="县纪委书记（待查）"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="柏乡县纪委书记、县监委主任" /><attvalue for="2" value="中共柏乡县纪律检查委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="unverified。县纪委书记姓名待查。" /></attvalues></node><node id="100001" label="中共柏乡县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="邢台市柏乡县" /></attvalues></node><node id="100002" label="柏乡县人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级" /><attvalue for="9" value="邢台市柏乡县" /></attvalues></node><node id="100003" label="柏乡县人大常委会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="人大" /><attvalue for="8" value="县级" /><attvalue for="9" value="邢台市柏乡县" /></attvalues></node><node id="100004" label="政协柏乡县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政协" /><attvalue for="8" value="县级" /><attvalue for="9" value="邢台市柏乡县" /></attvalues></node><node id="100005" label="中共柏乡县纪律检查委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="邢台市柏乡县" /></attvalues></node><node id="100006" label="中共柏乡县委组织部"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="邢台市柏乡县" /></attvalues></node><node id="100007" label="中共柏乡县委宣传部"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value