 value="2019-2024（有间隔）" /></attvalues></edge><edge id="5" source="3" target="2"><attvalues><attvalue for="0" value="same_system" /><attvalue for="1" value="两人均有大连市辖区/县级市主要领导工作经历，周振雷在普兰店-瓦房店-普兰店轮换，张延松在共青团-瓦房店-金普新区-普兰店路径" /><attvalue for="2" value="大连市" /></attvalues></edge><edge id="6" source="1" target="4"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="区委书记与区人大常委会主任; 邹积政此前曾任区委常委" /><attvalue for="2" value="中共大连市普兰店区委员会/普兰店区人大常委会" /><attvalue for="3" value="截至2025年12月" /></attvalues></edge><edge id="7" source="1" target="5"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="区委书记与区政协主席工作搭档" /><attvalue for="2" value="中共大连市普兰店区委员会/普兰店区政协" /><attvalue for="3" value="截至2026年7月" /></attvalues></edge><edge id="8" source="2" target="4"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="区长与区人大常委会主任工作搭档" /><attvalue for="2" value="大连市普兰店区人民政府/普兰店区人大常委会" /><attvalue for="3" value="2025年12月起" /></attvalues></edge><edge id="9" source="4" target="3"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="邹积政在普兰店区工作期间，周振雷曾任普兰店区委书记（2022-2025）" /><attvalue for="2" value="中共大连市普兰店区委员会" /><attvalue for="3" value="2022-2025" /></attvalues></edge></edges></graph><meta><title>普兰店区</title></meta></gexf>