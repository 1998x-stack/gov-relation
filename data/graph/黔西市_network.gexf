    <edges>
      <edge id="e1" source="p1" target="o1" label="中共黔西市委书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持市委全面工作。2026年6月26日、7月17日两次主持召开市委常委会（扩大）会议，传达学习中央、省和毕节市精神，研究部署城市更新、民生信访、防溺水、东西部协作及党建等工作。"/>
        </attvalues>
      </edge>
      <edge id="e2" source="p2" target="o1" label="黔西市委副书记、市人民政府党组书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="兼任市政府党组书记，主持市政府党组会议及市政府常务会议（2026-07-08）。"/>
        </attvalues>
      </edge>
      <edge id="e3" source="p2" target="o2" label="黔西市人民政府市长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="领导市政府全面工作，负责审计、粮食方面工作，分管市审计局。"/>
        </attvalues>
      </edge>
      <edge id="e4" source="p2" target="o7" label="贵州黔西经济开发区管委会主任（兼）" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="兼任经开区管委会主任，统筹园区开发建设。"/>
        </attvalues>
      </edge>
      <edge id="e5" source="p3" target="o1" label="黔西市委副书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="2026年6/7月市委常委会出席名单列为市委副书记。"/>
        </attvalues>
      </edge>
      <edge id="e6" source="p4" target="o1" label="黔西市委副书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="2026年6/7月市委常委会出席名单列为市委副书记。"/>
        </attvalues>
      </edge>
      <edge id="e7" source="p5" target="o2" label="黔西市委常委、副市长（分管常务工作）" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责市政府常务工作及发改、财政、统计、应急、国资、税务金融等，协助市长分管审计、粮食。"/>
        </attvalues>
      </edge>
      <edge id="e8" source="p6" target="o2" label="黔西市委常委、副市长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责教育、卫生健康、医疗保障、民族宗教、文史等。"/>
        </attvalues>
      </edge>
      <edge id="e9" source="p7" target="o2" label="黔西市人民政府副市长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责能源、煤矿安全生产、电力建设，分管市能源局。"/>
        </attvalues>
      </edge>
      <edge id="e10" source="p8" target="o2" label="黔西市人民政府副市长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责自然资源、住建、征地拆迁、城市管理、生态环保，主抓新型城镇化。"/>
        </attvalues>
      </edge>
      <edge id="e11" source="p9" target="o2" label="黔西市人民政府党组成员、副市长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责公安、国安、司法、退役军人事务，主持市公安局全面工作。"/>
        </attvalues>
      </edge>
      <edge id="e12" source="p9" target="o3" label="黔西市公安局党委书记、局长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持市公安局全面工作。"/>
        </attvalues>
      </edge>
      <edge id="e13" source="p10" target="o2" label="黔西市人民政府副市长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责工业、商贸、交通、市场监管、招商引资、文体广电旅游，主抓新型工业化和旅游产业化。"/>
        </attvalues>
      </edge>
      <edge id="e14" source="p11" target="o4" label="黔西市人大常委会主任" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="2026年7月市委常委会出席。"/>
        </attvalues>
      </edge>
      <edge id="e15" source="p12" target="o5" label="政协黔西市委员会主席" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="2026年7月市委常委会及民建中央调研陪同出席。"/>
        </attvalues>
      </edge>
      <edge id="e16" source="p13" target="o6" label="黔西市委常委、统战部部长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="2026-07-22 民建中央调研陪同领导之一。"/>
        </attvalues>
      </edge>
      <edge id="e17" source="p14" target="o2" label="黔西市原市委副书记、市人民政府市长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="2022年在任期间多次主持召开市第二届人民政府常务会议；后由张治国接任市长（其去向待查）。"/>
        </attvalues>
      </edge>
      <edge id="e18" source="p1" target="p2" label="党政搭档" weight="2.0">
