ue for="8" value="县处级" /><attvalue for="9" value="民权县" /></attvalues></node><node id="100006" label="民权县高新技术产业开发区"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="开发区" /><attvalue for="8" value="县处级" /><attvalue for="9" value="民权县" /></attvalues></node><node id="100007" label="商丘市人大常委会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="人大" /><attvalue for="8" value="地级市" /><attvalue for="9" value="商丘市" /></attvalues></node><node id="100008" label="中共商丘市委"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="地级市" /><attvalue for="9" value="商丘市" /></attvalues></node><node id="100009" label="商丘市人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="地级市" /><attvalue for="9" value="商丘市" /></attvalues></node><node id="100010" label="中共梁园区委"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="副厅级" /><attvalue for="9" value="商丘市梁园区" /></attvalues></node></nodes><edges><edge id="1" source="1" target="2"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="王静娴（县委书记）与王景义（县长）为全县党政正职搭档，共同主持县委县政府工作（多次同场出席会议，如植树活动、制冷博览会、县委会常务会）。" /><attvalue for="2" value="民权县" /><attvalue for="3" value="2023-至今" /></attvalues></edge><edge id="2" source="1" target="3"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="张团结 2023-05 离任民权县委书记，王静娴接任县委书记；张到商丘市人大任，2026-05-22 被查。" /><attvalue for="2" value="中共民权县委员会" /><attvalue for="3" value="2023-05" /></attvalues></edge><edge id="3" source="2" target="3"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="张团结任县委书记期间（2021-2023），王景义任民权常务副县长、代县长，同一班子工作。" /><attvalue for="2" value="民权县" /><attvalue for="3" value="2021-2023" /></attvalues></edge><edge id="4" source="1" target="4"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="王静娴（县委书记）与陈鸿志（县委副书记、政法委书记）在民权县委班子共事" /><attvalue for="2" value="民权县" /><attvalue for="3" value="当前" /></attvalues></edge><edge id="5" source="2" target="7"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="王景义（县长）与李卫政（常务副县长）为县政府正副职搭档，共同主持政府常务会议" /><attvalue for="2" value="民权县人民政府" /><attvalue for="3" value="当前" /></attvalues></edge><edge id="6" source="2" target="12"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="王景义（县长）与王玉军（高新区管委会主任）在政府常务会议同场，高新区主任列席" /><attvalue for="2" value="民权县" /><attvalue for="3" value="当前" /></attvalues></edge><edge id="7" source="1" target="5"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="王静娴（县委书记）与张爱军（县人大常委会主任）为全县核心领导，共证人大协商事项" /><attvalue for="2" value="民权县" /><attvalue for="3" value="当前" /></attvalues></edge><edge id="8" source="1" target="6"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="王静娴（县委书记）与周明河（县政协主席）共同出席植树等全县性活动" /><attvalue for="2" value="民权县" /><attvalue for="3" value="当前" /></attvalues></edge><edge id="9" source="1" target="9"><attvalues><attvalue for="0" value="overlap" /><attvalue for="1" value="王静娴（县委书记）与王晓敏（县纪委书记、监委主任）为县委纪委班子" /><attvalue for="2" value="民权县" /><attvalue for="3" value="当前" /></attvalues></edge></edges></graph><meta><title>民权县</title></meta></gexf>