<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="王静娴"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委书记" /><attvalue for="2" value="中共民权县委员会" /><attvalue for="3" value="女" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1977-11" /><attvalue for="6" value="Confirmed as 县委书记 since 2023-05-11 (中华网河南 2023-05-11; 河南省委组织部2023-04-28拟任公示; 民权县委常委会第150-164次会议 2026仍在任). 曾任民权县长(2021-08~2023-05), 此前任驻马店市政务服务和大数据管理局局长、正阳县委常委/宣传部部长/常务副县长." /></attvalues></node><node id="2" label="王景义"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委副书记、县长" /><attvalue for="2" value="民权县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1978-07" /><attvalue for="6" value="Confirmed via 澎湃 2023-10-12 '王景义当选为民权县政府县长'; 民权网 2026 仍为县委副书记、县长. 完整履历见百度百科: 1978-07生宁陵人, 1996参加工作, 1999入党, 党校研究生; 曾任宁陵县政府办干部/乡长、商丘市商务局副局长(援疆兵团十三师红山农场副场长)、民权县委常/常务副/代县长." /></attvalues></node><node id="3" label="张团结"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="商丘市人大常委会副主任、梁园区委书记（此前为民权县委书记）" /><attvalue for="2" value="商丘市人大常委会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="6" value="曾任民权县委副书记(2012)、民权县长(2015.03-2021.09)、民权县委书记(2021.09-2023.05); 后任商丘市人大常委会副主任、梁园区区委书记. ⚠️2026-05-22 接受纪律审查和监察调查(央视)." /></attvalues></node><node id="4" label="陈鸿志"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委副书记、政法委书记" /><attvalue for="2" value="中共民权县委员会" /><attvalue for="6" value="Confirmed via 民权网 2026-03-12 植树活动 (县委副书记、政法委书记陈鸿志) 及 2026-11 制冷博览会复盘会议." /></attvalues></node><node id="5" label="张爱军"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县人大常委会党组书记、主任" /><attvalue for="2" value="民权县人民代表大会常务委员会" /><attvalue for="6" value="Confirmed via 民权网 2026-04-03 人大常委第36次会议 (县人大常委会党组书记、主任张爱军)." /></attvalues></node><node id="6" label="周明河"><viz:size value="30.0" /><viz:shape value="diamond" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县政协主席" /><attvalue for="2" value="中国人民政治协商会议民权县委员会" /><attvalue for="6" value="Confirmed via 民权网 2026-03-12 植树活动 (县政协主席周明河)." /></attvalues></node><node id="7" label="李卫政"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、常务副县长" /><attvalue for="2" value="民权县人民政府" /><attvalue for="6" value="Confirmed via 民权网 2026-03-18 政府第64次常务会议及人大常委会议 (身为常、常务副)." /></attvalues></node><node id="8" label="李晓彬"><viz:size value="30.0" /><viz:shape value="circle" /><viz:color r="180" g="100" b="180" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、组织部部长（2026-07前后已交棒）" /><attvalue for="2" value="中共民权县委员会" /><attvalue for="6" value="Confirmed via 民权网 2026-04-03 人大常委会议 (县委常委、组织部部长李晓彬). 2026-07-09 人大八次会议报道显示组织部部长为祝金伟, 推定为中期调整." /></attvalues></node><node id="9" label="王晓敏"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、纪委书记、监委主任" /><attvalue for="2" value="民权县纪律检查委员会" /><attvalue for="6" value="Confirmed via 民权网 2026-04-03 (县委常委、县纪委书记、监委主任王晓敏) 及 商丘纪检监察网 领导机构 (监委主任:王晓敏)." /></attvalues></node><node id="10" label="毕道喜"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、宣传部部长、副县长" /><attvalue for="2" value="民权县人民政府" /><attvalue for="6" value="Confirmed via 中国县域 民权县政府领导分工 (民权县委常、宣传部长、县政府党组成员、副县长毕道喜)." /></attvalues></node><node id="11" label="李天桩"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县政府党组成员、副县长" /><attvalue for="2" value="民权县人民政府" /><attvalue for="6" value="Confirmed via 民权网 2026-03-18 政府第64次常务会议 及 分工." /></attvalues></node><node id="12" label="王玉军"><viz:size value="30.0" /><viz:shape value="circle" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县高新区管委会主任" /><attvalue for="2" value="民权县高新技术产业开发区" /><attvalue for="6" value="Confirmed via 民权网 政府常务会议列席 (县高新区管委会主任王玉军)." /></attvalues></node><node id="13" label="黄新峰"><viz:size value="30.0" /><viz:shape value="triangle" /><viz:color r="60" g="180" b="60" a="