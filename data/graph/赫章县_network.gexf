    <edges>
      <edge id="e1" source="p1" target="o1" label="中共赫章县委书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持县委全面工作。经官方 2026-07-06 通告确认在任；2026-07-28 以县委书记调研产业项目。前任胡书龙 2026-05-13 仍在任，交接窗口为 2026-05-13 后、2026-07-06 前。"/>
        </attvalues>
      </edge>
      <edge id="e2" source="p2" target="o1" label="赫章县委副书记、县人民政府党组书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="兼任县政府党组书记；办公室书记、县长互为 AB 岗（接访排班）。"/>
        </attvalues>
      </edge>
      <edge id="e3" source="p2" target="o2" label="赫章县县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="领导县政府全面工作，负责审计、粮食等工作。2026-05 至 08 多次调研教育、招商、产业等工作。"/>
        </attvalues>
      </edge>
      <edge id="e4" source="p3" target="o1" label="赫章县委副书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="协助县委书记抓党建，负责农业农村、乡村振兴、工青妇等（官方 2026-07-06 通告分管分工）。"/>
        </attvalues>
      </edge>
      <edge id="e5" source="p4" target="o1" label="赫章县委副书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="协助县委书记抓‘三农’、驻村工作。2026-05-13 县委常委会在列。"/>
        </attvalues>
      </edge>
      <edge id="e6" source="p5" target="o1" label="赫章县委常委、县委统战部部长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持县委统战部全面工作，负责统战、民族、宗教、侨务等。"/>
        </attvalues>
      </edge>
      <edge id="e7" source="p6" target="o1" label="赫章县委常委、县委政法委书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持县委政法委全面工作，负责政法、信访维稳、治安综治、消防、依法治县。"/>
        </attvalues>
      </edge>
      <edge id="e8" source="p7" target="o7" label="赫章县委常委、县纪委书记、县监委主任" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持县纪委监委全面工作，负责纪检、监察、巡察、党风廉政。"/>
        </attvalues>
      </edge>
      <edge id="e9" source="p8" target="o1" label="赫章县委常委、县委宣传部部长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持县委宣传部，负责宣传、意识形态、精神文明建设，联系教育、文旅等。"/>
        </attvalues>
      </edge>
      <edge id="e10" source="p9" target="o1" label="赫章县委常委、县委组织部部长、县直机关工委书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持县委组织部，负责组织、党建、人才、机构编制、干部考核等。"/>
        </attvalues>
      </edge>
      <edge id="e11" source="p10" target="o2" label="赫章县委常委、县政府常务副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责县政府常务工作，分管发改、财政、税务、应急、国资等；协助县长负责审计、粮食。县委常委会成员。"/>
        </attvalues>
      </edge>
      <edge id="e12" source="p11" target="o2" label="赫章县委常委、副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责自然资源（非常规矿）、住建、城管、交通运输、人社等。县委常委会成员。"/>
        </attvalues>
      </edge>
      <edge id="e13" source="p12" target="o2" label="赫章县委常委、副县长（挂职）" weight="1.0">
