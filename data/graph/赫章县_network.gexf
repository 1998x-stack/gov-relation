        </attvalues>
      </edge>
      <edge id="e14" source="p13" target="o2" label="赫章县委常委、副县长（挂职）" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="挂职副县长，负责中央统战部对口帮扶赫章工作，协助负责项目、乡村振兴、招商、文旅等。"/>
