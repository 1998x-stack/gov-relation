    <edges>
      <edge id="e1" source="p1" target="o1" label="中共织金县委书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持县委全面工作。2026年7月多次以县委书记身份召开县委常委会、主持招商引资调度会、专题会议，赴织金经开区调研重大项目建设。党内职务为毕节市政协副主席（副厅级）兼任，表明其同时担任贵州织金经济开发区党工委书记。"/>
        </attvalues>
      </edge>
      <edge id="e2" source="p1" target="o7" label="织金经济开发区党工委书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="主持织金经开区党工委工作（2026年7月多次以织金经开区党工委书记身份出席党工委会议）。"/>
        </attvalues>
      </edge>
      <edge id="e3" source="p1" target="o8" label="毕节市政协副主席" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="兼任（或曾任）毕节市政协副主席，与县委书记职务并行，体现市本级对重点县的领导配置；具体担任起止时间未知。"/>
        </attvalues>
      </edge>
      <edge id="e4" source="p2" target="o1" label="织金县委副书记、县人民政府党组书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="兼任县政府党组书记、县委政法委书记。"/>
        </attvalues>
      </edge>
      <edge id="e5" source="p2" target="o2" label="织金县县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="领导县政府全面工作，负责审计、粮食等工作，并主持县政府党组会、常务会议。2026年8月赴少普镇调研安全生产、防溺水。"/>
        </attvalues>
      </edge>
      <edge id="e6" source="p2" target="o7" label="织金经济开发区（织金县产业园区）管委会主任（兼）" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="兼任织金经济开发区党工委副书记、管委会主任，并任县法学会会长（兼）。"/>
        </attvalues>
      </edge>
      <edge id="e7" source="p3" target="o1" label="织金县委副书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="2026年7月出席县委常委会，并兼任织金经济开发区党工委副书记、管委会副主任。"/>
        </attvalues>
      </edge>
      <edge id="e8" source="p3" target="o7" label="织金经济开发区党工委副书记、管委会副主任" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="协助县委书记抓经开区工作。"/>
        </attvalues>
      </edge>
      <edge id="e9" source="p4" target="o1" label="织金县委副书记" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="2026年7月30日县委常委会出席名单列为县委副书记。"/>
        </attvalues>
      </edge>
      <edge id="e10" source="p5" target="o2" label="织金县委常委、常务副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="负责县政府常务工作，分管发改、财政、税务、金融、统计、国资等。"/>
        </attvalues>
      </edge>
      <edge id="e11" source="p6" target="o2" label="织金县人民政府副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="分管林业、水务、气象、卫生健康、医疗保障等，三级调研员。"/>
        </attvalues>
      </edge>
      <edge id="e12" source="p7" target="o2" label="织金县人民政府副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="分管生态环境保护、交通运输、民政、民族宗教等。2026年8月与县长马丽飞一同赴少普镇调研。"/>
        </attvalues>
      </edge>
      <edge id="e13" source="p8" target="o2" label="织金县人民政府副县长" weight="1.0">
        <attvalues>
          <attvalue for="0" value="worked_at"/>
          <attvalue for="1" value="分管公安、国安、维护社会稳定、交通安全、武装、司法、退役军人事务。"/>
        </attvalues>
      </edge>
