      </edge>
      <edge id="22" source="p1" target="p3" label="superior_subordinate" weight="2.0">
        <attvalues>
          <attvalue for="0" value="relationship"/>
          <attvalue for="1" value="何大海作为市委书记，冯海作为市委副书记，市委班子搭档。"/>
        </attvalues>
      </edge>
      <edge id="23" source="p1" target="p4" label="successor_predecessor_overlap" weight="2.0">
        <attvalues>
          <attvalue for="0" value="relationship"/>
          <attvalue for="1" value="何大海任期内，郑志刚由市长转任市人大常委会主任，属党政人大关键节点人事摆位。"/>
        </attvalues>
      </edge>
      <edge id="24" source="p1" target="p6" label="superior_subordinate" weight="2.0">
        <attvalues>
          <attvalue for="0" value="relationship"/>
          <attvalue for="1" value="何大海作为市委书记，刘祥锐为常委、常务副市长，市常委员会在同班子的协作。"/>
        </attvalues>
      </edge>
      <edge id="25" source="p2" target="p4" label="predecessor_successor" weight="2.0">
        <attvalues>
          <attvalue for="0" value="relationship"/>
          <attvalue for="1" value="市长继任链：郑志刚（前市长）→郑树一（现任市长）；郑志刚转任人大主任后，郑树一接任市长。"/>
        </attvalues>
      </edge>
      <edge id="26" source="p2" target="p3" label="overlap" weight="2.0">
        <attvalues>
          <attvalue for="0" value="relationship"/>
          <attvalue for="1" value="市政府党政领导在抚远市共事（市委副书记、市长 + 副职）。"/>
        </attvalues>
      </edge>
      <edge id="27" source="p15" target="p2" label="predecessor_successor" weight="2.0">
        <attvalues>
          <attvalue for="0" value="relationship"/>
          <attvalue for="1" value="市长继任链：范继涛（2024年市长）→ 郑志刚 → 郑树一。范继涛为郑树一的前前任。"/>
        </attvalues>
      </edge>
      <edge id="28" source="p15" target="p4" label="predecessor_successor" weight="2.0">
        <attvalues>
