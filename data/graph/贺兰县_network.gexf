<?xml version='1.0' encoding='utf-8'?>
<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="杨爱军"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委书记" /><attvalue for="2" value="中共贺兰县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1974年2月" /><attvalue for="6" value="杨爱军，男，汉族，1974年2月出生，宁夏灵武人，2000年6月加入中国共产党，1997年7月参加工作，西北政法大学法律专业毕业，大学学历。现任贺兰县委书记、县人民武装部党委第一书记。2025年8月11日任贺兰县委书记，2025年9月任县人武部党委第一书记。来源：贺兰县人民政府县委领导页、百度百科。confidence=confirmed" /></attvalues></node><node id="2" label="彭小沛"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委副书记、县长" /><attvalue for="2" value="贺兰县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1988年5月" /><attvalue for="6" value="彭小沛，男，汉族，1988年5月出生，硕士研究生学历，中共党员。2007年进入北京大学外国语学院英语系学习，获学士、硕士学位。毕业后赴宁夏工作。2025年3月14日被宣布提名贺兰县人民政府县长候选人（时任中卫市政府副秘书长、办公室主任）。来源：贺兰县人民政府、腾讯新闻、自治区党委组织部任前公示。confidence=confirmed" /></attvalues></node><node id="3" label="马小平"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委副书记、立岗镇党委书记" /><attvalue for="2" value="中共贺兰县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="回族" /><attvalue for="5" value="1985年11月" /><attvalue for="6" value="马小平，男，回族，1985年11月出生，中共党员，研究生学历，2010年9月参加工作。现任贺兰县委常委、副书记，立岗镇党委书记，县委国家安全委员会办公室主任（兼）。协助县委书记分管党的建设工作。来源：贺兰县人民政府县委领导页。confidence=confirmed" /></attvalues></node><node id="4" label="葸小明"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委常委（挂职）、贺兰工业园区党工委副书记、管委会主任" /><attvalue for="2" value="宁夏贺兰工业园区" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="葸小明，现任贺兰县委常委（挂职）、宁夏贺兰工业园区党工委副书记、管委会主任。来源：贺兰县人民政府县委领导页。confidence=confirmed（身份）" /></attvalues></node><node id="5" label="唐健"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委常委、政法委书记" /><attvalue for="2" value="中共贺兰县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="唐健，现任贺兰县委常委、政法委书记。来源：贺兰县人民政府县委领导名单。confidence=confirmed（身份）" /></attvalues></node><node id="6" label="王君"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委常委、纪委书记、监察委员会主任" /><attvalue for="2" value="中共贺兰县纪律检查委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="回族" /><attvalue for="5" value="1978年5月" /><attvalue for="6" value="王君，男，回族，1978年5月出生，中共党员，宁夏党校研究生，1999年7月参加工作。现任贺兰县委常委、纪委书记，监察委员会主任。主持县纪检监察、党风廉政建设和反腐败、巡察工作。来源：贺兰县人民政府县委领导页。confidence=confirmed" /></attvalues></node><node id="7" label="王鉴之"><viz:size value="30.0" /><viz:shape value="circle" /><viz:color r="180" g="100" b="180" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委常委、宣传部部长" /><attvalue for="2" value="中共贺兰县委员会" /><attvalue for="3" value="女" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1980年4月" /><attvalue for="6" value="王鉴之，女，汉族，1980年4月生，中共党员，宁夏党校研究生学历。现任贺兰县委常委、宣传部部长。来源：贺兰县人民政府县委领导页。confidence=confirmed" /></attvalues></node><node id="8" label="张楠"><viz:size value="30.0" /><viz:shape value="circle" /><viz:color r="180" g="100" b="180" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委常委、组织部部长" /><attvalue for="2" value="中共贺兰县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1986年8月" /><attvalue for="6" value="张楠，男，汉族，1986年8月出生，中共党员，大学学历，2010年9月参加工作。现任贺兰县委常委、组织部部长，县直机关工委委员、书记，县委党校（行政学校）校长。来源：贺兰县人民政府县委领导页。confidence=confirmed" /></attvalues></node><node id="9" label="蒋伟"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委常委、常务副县长" /><attvalue for="2" value="贺兰县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1978年12月" /><attvalue for="6" value="蒋伟，男，汉族，1978年12月出生，中共党员，在职大学学历。现任贺兰县委常委、县人民政府常务副县长。来源：贺兰县人民政府县委领导页。confidence=confirmed" /></attvalues></node><node id="10" label="丁尧"><viz:size value="30.0" /><viz:shape value="circle" /><viz:color r="180" g="100" b="180" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委常委、统战部部长" /><attvalue for="2" value="中共贺兰县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="丁尧，现任贺兰县委常委、统战部部长。来源：贺兰县人民政府县委领导名单。confidence=confirmed（身份）" /></attvalues></node><node id="11" label="陆成"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委常委、副县长" /><attvalue for="2" value="贺兰县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1983年11月" /><attvalue for="6" value="陆成，男，汉族，1983年11月出生，中共党员，大学学历。现任贺兰县委常委、县人民政府副县长。来源：贺兰县人民政府县委领导页。confidence=confirmed" /></attvalues></node><node id="12" label="杨振苗"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县委常委、副县长（挂职）" /><attvalue for="2" value="贺兰县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="杨振苗，现任贺兰县委常委、副县长（挂职）。来源：贺兰县人民政府县委领导名单。confidence=confirmed（身份）" /></attvalues></node><node id="13" label="田晓波"><viz:size value="30.0" /><viz:shape value="diamond" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县人大常委会主任" /><attvalue for="2" value="贺兰县人大常委会" /><attvalue for="3" value="男" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="田晓波，现任贺兰县人大常委会主任，多次列席县委常委会并出席春节走访慰问。来源：贺兰县人民政府新闻、常委会纪要。confidence=confirmed" /></attvalues></node><node id="14" label="陆斌"><viz:size value="30.0" /><viz:shape value="diamond" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="贺兰县政协主席" /><attvalue for="2" value="贺兰县政协" /><attvalue for="3" value="男" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="陆斌，现任贺兰县政协主席（县政协党组书记）。2026年3月26日主持政协第十一届贺兰县委员会第二十七次常委会会议。来源：银川市政协网站、贺兰县人民政府新闻。confidence=confirmed" /></attvalues></node><node id="20" label="丁炜"><viz:size value="30.0" /><viz:shape value="square" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="银川市人大常委会副主任（原贺兰县委书记）" /><attvalue for="2" value="银川市人大常委会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="丁炜，曾任银川市人大常委会副主任、贺兰县委书记。2025年8月11日不再担任贺兰县委书记，由杨爱军接替。来源：县人民政府新闻、澎湃新闻。confidence=confirmed（前职）" /></attvalues></node><node id="21" label="刘炳炳"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="待查（原贺兰县委副书记、县长）" /><attvalue for="3" value="女" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="刘炳炳，曾任贺兰县委副书记、县长（2023年8月时在任）。2025年初由彭小沛接替。2024年2月县政府领导分工通知显示刘炳炳为主持政府全面工作的县长。来源：贺兰县人民政府政府领导分工通知。confidence=confirmed" /></attvalues></node><node id="30" label="段建宏"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="待查（原贺兰县委常委、常务副县长）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="段建宏，曾任贺兰县委常委、县政府常务副县长（2022年12月县级河长分工、2024年县政府领导分工）。后由蒋伟接替常务副县长。来源：贺兰县人民政府河湖长、政府领导分工通知。confidence=confirmed" /></attvalues></node><node id="100001" label="中共贺兰县委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="宁夏回族自治区银川市贺兰县" /></attvalues></node><node id="100002" label="贺兰县人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级" /><attvalue for="9" value="宁夏回族自治区银川市贺兰县" /></attvalues></node><node id="100003" label="贺兰县人大常委会"><viz: