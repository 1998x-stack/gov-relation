<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="毕汝卫"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委书记（2022-06起；2026年中曾报道转任沧州市海洋和港航管理局党组书记）" /><attvalue for="2" value="中共南皮县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1977年7月" /><attvalue for="6" value="百度百科「毕汝卫」/「中国共产党南皮县委员会」：男，河北沧县人，1977-07生，中国农大毕业，1997参工/2004入党；沧州市新华区国债服务部→南大街办事处→新华区政府办科员、副主任→2017 新华区委常委、办公室主任→2019 沧州市委副秘书长→2021 沧州市体育局长→2021 黄骅市委副书记、市长→2022-06-11 南皮县委书记。沧州晚报/河北日报任前公示；2024-11 主持十二届县委113次常委；2026-02 人代会讲话；2026-07 公开报道指‘原南皮县委书记毕汝卫’履新沧州海洋和港航管理局党组书记。" /></attvalues></node><node id="2" label="罗遥"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委副书记、县长" /><attvalue for="2" value="南皮县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1987年12月" /><attvalue for="6" value="南皮县政府官网领导介绍（2023-08-04）：罗遥，男，汉族，1987-12生，博士研究生，中共党员，现任南皮县委副书记、县长；望海司2024-01「罗遥，清华大学博士，河北省2015年定向招录选调生，初在石家庄桥西区彭后街锻炼，2017-01到石家庄栾城区栾城镇任党委副书记、镇长，后任涞水县委常委、副县长」；2024-01-18 人大常委会任命副县长/代县长；2024-01-24 十八届人大五次会议补选县长；2024/2025/2026 多次主持县政府常务会议。" /></attvalues></node><node id="3" label="肖江普"><viz:size value="30.0" /><viz:shape value="diamond" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县人大常委会主任" /><attvalue for="2" value="南皮县人民代表大会（常务委员会）" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="南皮县政府《2026-02-16 县十八届人大六次会议闭幕》：大会主席团常务主席、执行主席 肖江普 主持大会；2025-01 十八届人大五次会议县处级领导名单将 肖江普列为人大主任。" /></attvalues></node><node id="4" label="邢毅"><viz:size value="30.0" /><viz:shape value="diamond" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县政协主席" /><attvalue for="2" value="中国人民政治协商会议南皮县委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="南皮县十八届人大五次会议（2025-2026）县处级领导名单：邢毅（县政协主席）；政协南皮县十届六次全会（2026-02-07，南皮发布）。" /></attvalues></node><node id="5" label="吴建业"><viz:size value="20.0" /><viz:shape value="circle" /><viz:color r="180" g="180" b="180" a="0.7" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委/县政府领导（分管乡村振兴统筹，温纯玉协助)" /><attvalue for="2" value="中共南皮县委员会／南皮县人民pie政府" /><attvalue for="3" value="男" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="南皮县政府官网领导介绍：温纯玉“协助 吴建业同志分管乡村振兴工作”；吴建业职务为县委/县政府分管领导，精确职务待核。" /></attvalues></node><node id="6" label="温纯玉"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县委常委、副县长" /><attvalue for="2" value="南皮县人民政府 / 中共南皮县委员会" /><attvalue for="3" value="女" /><attvalue for="4" value="满族" /><attvalue for="5" value="1981年3月" /><attvalue for="6" value="南皮县政府官网领导介绍（发布日期2023-11-10）：温纯玉，女，1981年3月生，满族，研究生，现任南皮县委常委、副县长；负责残联工作，协助吴建业同志分管乡村振兴工作；分管残疾人联合会。2025-01 十八届人大五次会议县处级领导名单亦含温纯玉。" /></attvalues></node><node id="7" label="董继华"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="唐山市委常委、曹妃甸区委书记（前任南皮县委书记）" /><attvalue for="2" value="中共唐山市曹妃甸区委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="本地库 data/persons/20260805-河北省-唐山市-区委书记-董继华.json：2021-05 任南皮县委书记（一级调研员），2021-07 离任后赴河北省工业和信息化厅副厅长，现任唐山市委常委、曹妃甸区委书记。" /></attvalues></node><node id="8" label="胡学锋"><viz:size value="50.0" /><viz:shape value="circle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="前任南皮县长（约2021-05 至 2024-01）" /><attvalue for="2" value="南皮县人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="澎湃/望海司 2024-01《沧州一地县长有变》：前任南皮县长任期约 2021-05 至 2024-01，罗遥接任。360百科南皮县（2024-06快照）记县长 胡学锋。" /></attvalues></node><node id="9" label="李军"><viz:size value="20.0" /><viz:shape value="circle" /><viz:color r="180" g="180" b="180" a="0.7" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县处级领导（县委班子成员）" /><attvalue for="2" value="中共南皮县委员会" /><attvalue for="3" value="待查" /><attvalue for="4" value="待查" /><attvalue for="5" value="待查" /><attvalue for="6" value="2025-06/ 南皮县十八届人大五次会议县处级领导名单。具体职务待查。" /></attvalues></node><node id="10" label="刘席纲"><viz:size value="20.0" /><viz:shape value="circle" /><viz:color r="180" g="180" b="180" a="0.7" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="县处级领导（县委班子成员）" /><attvalue for="2" value="中共南皮县委员会" /><attvalue for="3" value="