<gexf xmlns="http://www.gexf.net/1.3" xmlns:viz="http://www.gexf.net/1.3/viz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.gexf.net/1.3 http://www.gexf.net/1.3/gexf.xsd" version="1.3"><graph mode="static" defaultedgetype="directed"><attributes class="node"><attribute id="0" title="type" type="string" /><attribute id="1" title="current_post" type="string" /><attribute id="2" title="current_org" type="string" /><attribute id="3" title="gender" type="string" /><attribute id="4" title="ethnicity" type="string" /><attribute id="5" title="birth" type="string" /><attribute id="6" title="source" type="string" /><attribute id="7" title="org_type" type="string" /><attribute id="8" title="level" type="string" /><attribute id="9" title="location" type="string" /></attributes><attributes class="edge"><attribute id="0" title="type" type="string" /><attribute id="1" title="context" type="string" /><attribute id="2" title="overlap_org" type="string" /><attribute id="3" title="overlap_period" type="string" /></attributes><nodes><node id="1" label="马洪广"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="邯郸市永年区委书记" /><attvalue for="2" value="中共邯郸市永年区委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="永年区融媒体/网信永年 2026 新春贺词（马洪广、张宁署名）;永年区2026市两会代表团团长;永年区领导班子联系电话表。履历：磁县林坦镇→临漳县委（农工委、宣传部长兼统战部长）→成安县委常委、组织部长→鸡泽县长提名→广平县委书记→永年区委书记。置信度：confirmed" /></attvalues></node><node id="2" label="张宁"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="邯郸市永年区委副书记、区长" /><attvalue for="2" value="永年区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1983年11月" /><attvalue for="6" value="永年区人民政府官网领导信息：张宁，男，汉族，1983年11月生，大学学历，法学学士，中共党员，现任邯郸市永年区委副书记，区政府区长、党组书记。“八零后”区县主官，2025年由区委副书记、代区长正式任职区长。置信度：confirmed" /></attvalues></node><node id="3" label="孙立军"><viz:size value="45.0" /><viz:shape value="square" /><viz:color r="220" g="80" b="80" a="0.9" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="永年区委副书记" /><attvalue for="2" value="中共邯郸市永年区委员会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="永年区全民健身日活动、党课及多项活动报道均确认孙立军任永年区委副书记。置信度：confirmed" /></attvalues></node><node id="4" label="郑佩山"><viz:size value="30.0" /><viz:shape value="diamond" /><viz:color r="60" g="180" b="60" a="0.85" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="永年区人大常委会主任" /><attvalue for="2" value="永年区人大常委会" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="永年区2026市两会代表团，区委书记马洪广为团长，区长张宁与人大主任郑佩山为副团长。置信度：confirmed" /></attvalues></node><node id="5" label="申涛"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="永年区委常委、常务副区长" /><attvalue for="2" value="永年区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="永年区人民政府领导分工：申涛常务副区长，负责政府办、发展改革、财税、园区、国土资源、统计、物价、科技、地震、节能减排等工作。置信度：confirmed" /></attvalues></node><node id="6" label="董红坤"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="永年区政府副区长" /><attvalue for="2" value="永年区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="永年区活动报道：区委副书记孙立军、区人大副主任苏彦忠、区政府副区长董红坤出席。置信度：confirmed" /></attvalues></node><node id="7" label="王华"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="永年区政府副区长" /><attvalue for="2" value="永年区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="永年区政府旅游工作会议（区委副书记孙立军主持，副区长王华出席）。置信度：confirmed" /></attvalues></node><node id="8" label="刘子珂"><viz:size value="50.0" /><viz:shape value="triangle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="永年区政府副区长" /><attvalue for="2" value="永年区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="永年区省道S344尖永公路、永年北互通项目推进会（区长陈涛、区领导刘子珂出席）。置信度：confirmed" /></attvalues></node><node id="9" label="侯有民"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="离任（原永年区委书记）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="永年区全区领导干部大会宣布任免：马洪广同志任永年区委书记；侯有民同志不再担任永年区委书记。置信度：confirmed" /></attvalues></node><node id="10" label="陈涛"><viz:size value="50.0" /><viz:shape value="circle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="前任（永年区区长）" /><attvalue for="2" value="永年区人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="永年区通讯稿：陈涛任永年区政府副区长、代理区长（2021-05 区一届人大常委会第四十二次会议），后任区长，2023 年区政府工作报告、2024-2025 项目推进会均以区长身份出席；约 2025 年由张宁接任。置信度：confirmed（身份）/partial（去向未查清）" /></attvalues></node><node id="11" label="李书峰"><viz:size value="50.0" /><viz:shape value="circle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="离任（原永年区区长）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="永年区人大常委会关于接受李书峰同志辞去永年区人民政府区长职务请求的决定。置信度：confirmed" /></attvalues></node><node id="12" label="边飞"><viz:size value="60.0" /><viz:shape value="square" /><viz:color r="200" g="30" b="30" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="已落马（原永年县委书记、大名县委书记）" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="待查" /><attvalue for="6" value="本项目 repository：build_大名县_data.py、大名县前任去向调查报告。边飞曾任曲周县副县长、临漳县委副书记、魏县县长/书记、永年县委书记（约2008-2012）、邯郸市委常委兼大名县委书记，后落马被判刑。置信度：confirmed（本地履历库）" /></attvalues></node><node id="13" label="王清宪"><viz:size value="60.0" /><viz:shape value="circle" /><viz:color r="30" g="100" b="200" a="1.0" /><attvalues><attvalue for="0" value="person" /><attvalue for="1" value="安徽省省长" /><attvalue for="2" value="安徽省人民政府" /><attvalue for="3" value="男" /><attvalue for="4" value="汉族" /><attvalue for="5" value="1963年7月" /><attvalue for="6" value="本项目 repository：data/persons/20260725-山东省-青岛市-安徽省省长-王清宪.json；build_青岛市_data.py。河北永年籍。置信度：confirmed" /></attvalues></node><node id="100001" label="中共邯郸市永年区委员会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="党委" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市永年区" /></attvalues></node><node id="100002" label="永年区人民政府"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="政府" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市永年区" /></attvalues></node><node id="100003" label="永年区人大常委会"><viz:size value="15.0" /><viz:shape value="hexagon" /><viz:color r="220" g="220" b="220" a="0.8" /><attvalues><attvalue for="0" value="organization" /><attvalue for="7" value="人大" /><attvalue for="8" value="县级" /><attvalue for="9" value="邯郸市永年区" /></attvalues></node><node id="100004" label="安徽省人民政府"><viz:size value="15.0" /><viz:shape value="h