      <edge id="21" source="p1" target="p2" label="superior_subordinate" weight="2.0">
        <attvalues>
          <attvalue for="0" value="relationship"/>
          <attvalue for="1" value="付刚作为县委书记，杨洪武作为县委副书记、县长，党政主要领导搭档；付刚主持县委，杨洪武主持政府。"/>
