          <attvalue for="1" value="杨洪武任县长后，朱军烈为副县长，与其政府班子共事。"/>
        </attvalues>
      </edge>
      <edge id="27" source="p3" target="p1" label="superior_subordinate" weight="2.0">
        <attvalues>
          <attvalue for="0" value="relationship"/>
          <attvalue for="1" value="李佳杰为县委副书记，在其任内与县委书记付刚同任县委班子。"/>
