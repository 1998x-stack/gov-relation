      <edge id="e30" source="p1" target="p2" label="唐振生任市委书记、苏志远任市长。苏志远由副市长升任市长，接替唐振生曾任的市长岗位；现为一二把手搭档。" weight="2.0">
        <attvalues>
          <attvalue for="0" value="relationship"/>
          <attvalue for="1" value="唐振生任市委书记、苏志远任市长。苏志远由副市长升任市长，接替唐振生曾任的市长岗位；现为一二把手搭档。"/>
        </attvalues>
      </edge>
      <edge id="e31" source="p1" target="p2" label="苏志远接替唐振生出任市长（唐升任书记），历史上同在敦化市政府班子。" weight="2.0">
