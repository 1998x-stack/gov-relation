get="2"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="金培元（区委书记）与陈国帮（区长）为新华区党政主要领导搭档关系。金培元此前也任新华区长，陈国帮接任区长职务。" /><attvalue for="2" value="中共沧州市新华区委员会 / 新华区人民政府" /><attvalue for="3" value="约2021至今" /></attvalues></edge><edge id="2" source="1" target="9"><attvalues><attvalue for="0" value="predecessor_successor" /><attvalue for="1" value="金培元接替刘建华任新华区委书记。刘建华约2016-2021年任书记，金培元约2021年接任。" /><attvalue for="2" value="中共沧州市新华区委员会" /><attvalue for="3" value="约2021交接" /></attvalues></edge><edge id="3" source="1" target="3"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="金培元（书记）与刘文新（常务副区长）为党政班子成员。" /><attvalue for="2" value="新华区党政领导班子" /><attvalue for="3" value="待查" /></attvalues></edge><edge id="4" source="1" target="4"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="金培元作为区委书记，与组织部部长张秀娟共同负责干部管理工作。" /><attvalue for="2" value="中共沧州市新华区委员会" /><attvalue for="3" value="待查" /></attvalues></edge><edge id="5" source="2" target="3"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="陈国帮（区长）与刘文新（常务副区长）为区政府正副职搭档。" /><attvalue for="2" value="新华区人民政府" /><attvalue for="3" value="待查" /></attvalues></edge><edge id="6" source="1" target="5"><attvalues><attvalue for="0" value="superior_subordinate" /><attvalue for="1" value="金培元（书记）与辛连昌（纪委书记）在区委常委会中共事。" /><attvalue for="2" value="中共沧州市新华区委员会" /><attvalue for="3" value="待查" /></attvalues></edge></edges></graph><meta><title>新华区</title></meta></gexf>